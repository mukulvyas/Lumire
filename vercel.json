{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lumiere-frontend": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "lumiere-backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "lumiere-backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "lumiere-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "lumiere-frontend"
      }
    }
  ]
}
